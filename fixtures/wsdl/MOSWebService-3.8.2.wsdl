xmlns="http://schemas.xmlsoap.org/wsdl/">mosReqObjList To retrieve
only selected object descriptions from a MOS. Profile 3 required MOS message
support</documentation> 

  <wsdl:input
message="tns:mosReqObjListSoapIn" /> 

  <wsdl:output
message="tns:mosReqObjListSoapOut" /> 

  </wsdl:operation>

