{
  "_comment": [
    "SPDX-FileCopyrightText: 2026 Javier O. Cordero Pérez",
    "SPDX-License-Identifier: Apache-2.0",
    "",
    "Hand-maintained message annotations for tools/codegen/gen_messages.py",
    "(implementation plan §4.5). The DTD/XSD extracted from the spec carry the",
    "content models; this file carries what the schemas cannot express, taken",
    "from the spec's per-message annotations:",
    "  - channel: the per-message 'Port' annotation (mom=10540, ro=10541,",
    "    aux=10542, any=valid on all channels, none=host↔plug-in, not network)",
    "  - profile: profile membership per spec §2.3 / plan §3.2 (null = not a",
    "    profile member: removed legacy messages and the plug-in family)",
    "  - responses: the spec's 'Response' annotation — message types that",
    "    complete this exchange for the in-flight-of-one sequencer",
    "  - isAck: this message completes exchanges rather than opening one",
    "  - legacyRemoved: one of the thirteen messages removed in v4.0 (§3.2);",
    "    parsed and normalized, never sent in 4.0 mode",
    "  - plugin: web-control (ActiveX/HTML5) chapter-5 family",
    "  - envelope: 'full' = mosID,ncsID,messageID; 'ids' = mosID,ncsID only",
    "    (keepAlive carries no messageID per spec §4.1.1); 'none' = bare <mos>",
    "    wrapper (plug-in host messages)",
    "",
    "supplementalContentModels: elements referenced by the spec but missing",
    "from the (knowingly imperfect) printed DTD. The eleven legacy models come",
    "from the spec XSD chapter 9; roStat and roItemStat are absent from the",
    "4.0 schemas entirely and follow MOS 2.8.5 §3.6."
  ],
  "messages": {
    "keepAlive":              { "channel": "any", "profile": 0, "responses": [], "envelope": "ids" },
    "heartbeat":              { "channel": "any", "profile": 0, "responses": ["heartbeat"] },
    "reqMachInfo":            { "channel": "any", "profile": 0, "responses": ["listMachInfo"] },
    "listMachInfo":           { "channel": "any", "profile": 0, "responses": [] },

    "mosAck":                 { "channel": "mom", "profile": 1, "responses": [], "isAck": true },
    "mosObj":                 { "channel": "mom", "profile": 1, "responses": ["mosAck"] },
    "mosReqObj":              { "channel": "mom", "profile": 1, "responses": ["mosObj", "mosAck"] },
    "mosReqAll":              { "channel": "mom", "profile": 1, "responses": ["mosAck"] },
    "mosListAll":             { "channel": "mom", "profile": 1, "responses": ["mosAck"] },

    "roAck":                  { "channel": "ro", "profile": 2, "responses": [], "isAck": true },
    "roCreate":               { "channel": "ro", "profile": 2, "responses": ["roAck"] },
    "roReplace":              { "channel": "ro", "profile": 2, "responses": ["roAck"] },
    "roMetadataReplace":      { "channel": "ro", "profile": 2, "responses": ["roAck"] },
    "roDelete":               { "channel": "ro", "profile": 2, "responses": ["roAck"] },
    "roReq":                  { "channel": "ro", "profile": 2, "responses": ["roList", "roAck"] },
    "roList":                 { "channel": "ro", "profile": 2, "responses": [] },
    "roReadyToAir":           { "channel": "ro", "profile": 2, "responses": ["roAck"] },
    "roElementAction":        { "channel": "ro", "profile": 2, "responses": ["roAck"] },
    "roElementStat":          { "channel": "ro", "profile": 2, "responses": ["roAck"] },

    "mosObjCreate":           { "channel": "mom", "profile": 3, "responses": ["mosAck"] },
    "mosItemReplace":         { "channel": "ro", "profile": 3, "responses": ["roAck"] },
    "mosReqObjAction":        { "channel": "mom", "profile": 3, "responses": ["mosAck"] },
    "mosReqSearchableSchema": { "channel": "aux", "profile": 3, "responses": ["mosListSearchableSchema"] },
    "mosListSearchableSchema":{ "channel": "aux", "profile": 3, "responses": [] },
    "mosReqObjList":          { "channel": "aux", "profile": 3, "responses": ["mosObjList"] },
    "mosObjList":             { "channel": "aux", "profile": 3, "responses": [] },

    "roReqAll":               { "channel": "ro", "profile": 4, "responses": ["roListAll"] },
    "roListAll":              { "channel": "ro", "profile": 4, "responses": [] },
    "roStorySend":            { "channel": "ro", "profile": 4, "responses": ["roAck"] },

    "roItemCue":              { "channel": "ro", "profile": 5, "responses": ["roAck"] },
    "roCtrl":                 { "channel": "ro", "profile": 5, "responses": ["roAck"] },

    "roReqStoryAction":       { "channel": "ro", "profile": 7, "responses": ["roAck"] },

    "roStoryAppend":          { "channel": "ro", "profile": null, "responses": ["roAck"], "legacyRemoved": true },
    "roStoryInsert":          { "channel": "ro", "profile": null, "responses": ["roAck"], "legacyRemoved": true },
    "roStoryReplace":         { "channel": "ro", "profile": null, "responses": ["roAck"], "legacyRemoved": true },
    "roStoryMove":            { "channel": "ro", "profile": null, "responses": ["roAck"], "legacyRemoved": true },
    "roStoryMoveMultiple":    { "channel": "ro", "profile": null, "responses": ["roAck"], "legacyRemoved": true },
    "roStorySwap":            { "channel": "ro", "profile": null, "responses": ["roAck"], "legacyRemoved": true },
    "roStoryDelete":          { "channel": "ro", "profile": null, "responses": ["roAck"], "legacyRemoved": true },
    "roItemInsert":           { "channel": "ro", "profile": null, "responses": ["roAck"], "legacyRemoved": true },
    "roItemReplace":          { "channel": "ro", "profile": null, "responses": ["roAck"], "legacyRemoved": true },
    "roItemMoveMultiple":     { "channel": "ro", "profile": null, "responses": ["roAck"], "legacyRemoved": true },
    "roItemDelete":           { "channel": "ro", "profile": null, "responses": ["roAck"], "legacyRemoved": true },
    "roStat":                 { "channel": "ro", "profile": null, "responses": ["roAck"], "legacyRemoved": true },
    "roItemStat":             { "channel": "ro", "profile": null, "responses": ["roAck"], "legacyRemoved": true },

    "ncsAck":                 { "channel": "none", "profile": null, "responses": [], "isAck": true, "plugin": true, "envelope": "none" },
    "ncsReqAppInfo":          { "channel": "none", "profile": null, "responses": ["ncsAppInfo", "ncsAck"], "plugin": true, "envelope": "none" },
    "ncsAppInfo":             { "channel": "none", "profile": null, "responses": [], "plugin": true },
    "ncsReqAppMode":          { "channel": "none", "profile": null, "responses": ["ncsAppInfo", "ncsAck"], "plugin": true, "envelope": "none" },
    "ncsStoryRequest":        { "channel": "none", "profile": null, "responses": ["roStorySend", "ncsAck"], "plugin": true, "envelope": "none" },
    "ncsItemRequest":         { "channel": "none", "profile": null, "responses": ["ncsItem", "ncsAck"], "plugin": true, "envelope": "none" },
    "ncsItem":                { "channel": "none", "profile": null, "responses": ["ncsAck"], "plugin": true, "envelope": "none" },
    "ncsReqAppClose":         { "channel": "none", "profile": null, "responses": ["ncsAck"], "plugin": true, "envelope": "none" },
    "ncsReqStoryAction":      { "channel": "none", "profile": null, "responses": ["ncsAck"], "plugin": true }
  },
  "supplementalContentModels": {
    "roStoryReplace":      "(roID, storyID, story+)",
    "roStoryMove":         "(roID, storyID, storyID)",
    "roStoryMoveMultiple": "(roID, storyID+)",
    "roStorySwap":         "(roID, storyID, storyID)",
    "roStoryDelete":       "(roID, storyID+)",
    "roItemInsert":        "(roID, storyID, itemID, item+)",
    "roItemReplace":       "(roID, storyID, itemID, item+)",
    "roItemMoveMultiple":  "(roID, storyID, itemID+)",
    "roItemDelete":        "(roID, storyID, itemID+)",
    "roStat":              "(roID, status?, time?)",
    "roItemStat":          "(roID, storyID, itemID, objID, itemChannel?, status, time)"
  },
  "viewSkipElements": ["mos", "b", "i", "u", "em", "tab", "p", "pi", "pkg", "description"]
}
